# ==============================================================================
# Gmail Daily Digest - Environment Configuration
# ==============================================================================
# The application automatically runs in Safe Demo Mode if Google OAuth credentials
# are not provided, allowing full local evaluation with realistic simulated email data.

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Credentials (Required for Live Gmail Sync)
# ------------------------------------------------------------------------------
# Create these in Google Cloud Console (https://console.cloud.google.com/):
#   1. Create or select a project.
#   2. Enable the "Gmail API".
#   3. Under "APIs & Services" > "OAuth consent screen", choose External or Internal.
#      Add the read-only scope: https://www.googleapis.com/auth/gmail.readonly
#   4. Under "Credentials", create "OAuth client ID" > Application type: "Web application".
#   5. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ------------------------------------------------------------------------------
# 2. Security & Token Encryption
# ------------------------------------------------------------------------------
# 32-byte hex secret used for AES-256-GCM encryption of stored OAuth refresh tokens.
# Generate one with: openssl rand -hex 32
ENCRYPTION_SECRET=e87b6495df025d57b102b7405239a2ffbcf3ecdae094f691b106e236529341f2

# Session secret for signed cookies / local session state
SESSION_SECRET=c082729a9871f302b1cde8264931bc109f5827361849203ba30284716a5b4c3d

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Optional Email Delivery Configuration (For Sending Summary Emails)
# ------------------------------------------------------------------------------
# If omitted, summaries are delivered securely inside the web application,
# and users can preview/download the rendered email or trigger mock dispatches.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Gmail Daily Digest <digest@example.com>"
